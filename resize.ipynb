   "source": [
    "from PIL import Image, ImageOps\n",
    "\n",
    "photo = Image.open('my_photo.jpg')\n",
    "photo = ImageOps.exif_transpose(photo)      # phone photos: put them the right way up\n",
    "photo.thumbnail((800, 800))                 # at most 800 pixels wide or high\n",
    "photo.save('me.jpg', quality=85)"
   ]
